# Reference only: config.py does NOT automatically load a root .env file.
# Use process environment variables or the existing API_Key_and_Tools/*.env files.
# Never overwrite existing credential files with this template.
DEEPSEEK_API_KEY=
TEXT_MODEL_NAME=
TEXT_MODEL_BASE_URL=https://api.deepseek.com/v1
# If setting TEXT_MODEL_NAME, provide a real model supported by your account.
# Otherwise omit that variable to use config.py defaults; blank overrides are invalid.

# Generate with API_Key_and_Tools/ensure_mcp_secret.py; do not share the secret.
MCP_TOKEN_SECRET=
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp
MATPLOTLIB_KNOWLEDGE_BASE_ID=matplotlib-course-v1
MCP_TOKEN_TTL_SECONDS=3600

# JSON user_id -> SHA-256(original access token), not plaintext passwords/tokens.
APP_USER_TOKENS_JSON={}
APP_USER_KB_ACCESS_JSON={}
REDIS_URL=redis://localhost:6379/0

# Optional visual understanding; leave unconfigured for OCR fallback.
VISION_MODEL=
VISION_MODEL_BASE_URL=
VISION_API_KEY=

# Model context budgets are separate from MCP authentication token lifetime.
MODEL_CONTEXT_TOKENS=131072
OUTPUT_RESERVE_TOKENS=8192
MAX_AGENT_STEPS=6
